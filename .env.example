# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Postgres (Supavisor pooled, transaction mode) ---
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Direct connection (apenas para drizzle-kit migrations)
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- App ---
SESSION_SECRET=GENERATE_64_BYTES_HEX
NODE_ENV=development
